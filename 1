<title>Варвара Алексеева — технический специалист GetCourse и Salebot</title>
<meta name="description" content="Настраиваю GetCourse, чат-ботов и воронки для онлайн-школ и экспертов. Пермь, МСК+2.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800&family=Onest:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f3f6fa; --surface:#ffffff; --ink:#13202e; --muted:#51606f; --line:#d8e0e9;
  --accent:#1f6fd6; --accent-ink:#ffffff; --ok:#12805c; --ok-bg:#dff3ea; --chip:#e6eef8;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0e1721; --surface:#16222f; --ink:#e8eef5; --muted:#9fb0c1; --line:#26364a;
    --accent:#5aa2ff; --accent-ink:#08121d; --ok:#4cd3a1; --ok-bg:#12372d; --chip:#1d2d40;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0e1721; --surface:#16222f; --ink:#e8eef5; --muted:#9fb0c1; --line:#26364a;
  --accent:#5aa2ff; --accent-ink:#08121d; --ok:#4cd3a1; --ok-bg:#12372d; --chip:#1d2d40;
  color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:6px}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
section{padding:56px 0}
h1,h2,h3{line-height:1.15;margin:0}
h1{font-size:clamp(2.2rem,6.5vw,3.8rem);letter-spacing:-.02em;max-width:18ch}
h2{font-size:clamp(1.5rem,3.5vw,2rem);letter-spacing:-.01em;margin-bottom:24px}
h3{font-size:1.05rem;margin-bottom:10px}
p{margin:0 0 14px;max-width:62ch}
.muted{color:var(--muted)}
header.bar{display:flex;justify-content:space-between;align-items:center;padding:18px 0}
.logo{font-weight:700;text-decoration:none}
.theme{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:8px 14px;font:inherit;font-size:.9rem;cursor:pointer}
.hero{padding-top:32px}
.hero p.lead{font-size:1.2rem;margin-top:20px;color:var(--muted)}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-block;padding:13px 22px;border-radius:12px;font-weight:600;text-decoration:none;border:1px solid var(--line);background:var(--surface)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn:hover{border-color:var(--accent)}
.facts{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:28px;font-size:.95rem;color:var(--muted)}
/* the funnel: the one memorable element */
.flow-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px}
.flow-card h2{margin-bottom:6px}
.flow{list-style:none;margin:24px 0 0;padding:0;display:flex;flex-direction:column;gap:0}
.flow li{position:relative;display:flex;gap:14px;align-items:flex-start;padding:0 0 22px 0}
.flow li::before{content:"";position:absolute;left:15px;top:32px;bottom:2px;width:2px;background:var(--line)}
.flow li:last-child{padding-bottom:0}
.flow li:last-child::before{display:none}
.dot{flex:none;width:32px;height:32px;border-radius:50%;background:var(--chip);border:2px solid var(--accent);display:grid;place-items:center;font-size:.9rem;font-weight:700;color:var(--accent)}
.flow li.done .dot{background:var(--ok-bg);border-color:var(--ok);color:var(--ok)}
.flow b{display:block}
.flow span{color:var(--muted);font-size:.95rem}
@media (min-width:760px){
  .flow{flex-direction:row;gap:12px}
  .flow li{flex:1;flex-direction:column;padding:0}
  .flow li::before{left:44px;right:-12px;top:15px;bottom:auto;width:auto;height:2px}
}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px}
.card ul{margin:0;padding-left:18px;color:var(--muted);font-size:.97rem}
.card li{margin-bottom:6px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.chips li{background:var(--chip);padding:6px 14px;border-radius:999px;font-size:.92rem}
.job{border-left:3px solid var(--accent);padding-left:18px;margin-bottom:28px}
.job .when{color:var(--muted);font-size:.92rem}
.job ul{padding-left:18px;margin:10px 0 0;color:var(--muted)}
.job li{margin-bottom:4px}
.cta{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:32px 24px}
.cases{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.case{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:24px}
.case.big{grid-column:1/-1}
.case .tools{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px;padding:0;list-style:none}
.case .tools li{background:var(--chip);color:var(--accent);padding:3px 10px;border-radius:999px;font-size:.82rem;font-weight:600}
.case p{font-size:.97rem}
.case ul.done{margin:0 0 14px;padding-left:18px;color:var(--muted);font-size:.95rem}
.case ul.done li{margin-bottom:5px}
.case .res{margin-top:auto;padding:12px 14px;border-radius:10px;background:var(--ok-bg);color:var(--ink);font-size:.93rem}
.case .more{display:inline-block;margin-top:12px;font-size:.92rem;font-weight:600;color:var(--accent)}
.case .nums{display:flex;flex-wrap:wrap;gap:8px 24px;margin:0 0 14px;font-size:.93rem}
.case .nums b{font-size:1.25rem;margin-right:4px}
footer{padding:32px 0 48px;color:var(--muted);font-size:.9rem}
:root{--bg:#eceeff;--surface:#ffffff;--ink:#16123a;--muted:#4b4872;--line:#16123a;--accent:#5b3df5;--accent-ink:#ffffff;--ok:#0a7d5a;--ok-bg:#c9f5e3;--chip:#ffe27a;--pop:#ff6b5b;--shadow:#16123a;--dot:#c6cbf6}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12102b;--surface:#1d1a45;--ink:#f3f1ff;--muted:#b9b5e2;--line:#f3f1ff;--accent:#8f7bff;--accent-ink:#12102b;--ok:#5eeab8;--ok-bg:#12423a;--chip:#3a3380;--pop:#ff8a7c;--shadow:#8f7bff;--dot:#2a2660}}
:root[data-theme="dark"]{--bg:#12102b;--surface:#1d1a45;--ink:#f3f1ff;--muted:#b9b5e2;--line:#f3f1ff;--accent:#8f7bff;--accent-ink:#12102b;--ok:#5eeab8;--ok-bg:#12423a;--chip:#3a3380;--pop:#ff8a7c;--shadow:#8f7bff;--dot:#2a2660}
body{font-family:Onest,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background-color:var(--bg);background-image:radial-gradient(var(--dot) 1.6px,transparent 1.6px);background-size:24px 24px}
.wrap{max-width:1040px}
h1,h2{font-family:Unbounded,Onest,system-ui,sans-serif;font-weight:800}
h1{font-size:clamp(1.9rem,4.8vw,3.3rem);line-height:1.12;letter-spacing:-.02em;max-width:17ch}
h2{font-size:clamp(1.3rem,3vw,1.75rem);display:flex;align-items:center;gap:.5em}
h2::before{content:"";flex:none;width:.6em;height:.6em;background:var(--pop);border:2px solid var(--ink);border-radius:50%}
.card,.cta,.flow-card,.case,.theme{border:2px solid var(--ink);box-shadow:5px 5px 0 var(--shadow)}
.flow-card,.cta{box-shadow:7px 7px 0 var(--shadow);border-radius:20px}
.theme{box-shadow:3px 3px 0 var(--shadow);font-weight:700}
.btn{border:2px solid var(--ink);box-shadow:4px 4px 0 var(--shadow);transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--shadow);border-color:var(--ink)}
.btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--shadow)}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.facts span{background:var(--surface);border:2px solid var(--ink);border-radius:999px;padding:2px 12px;color:var(--ink);font-weight:600}
.case{border-top-width:12px;border-top-color:var(--c,var(--accent));transition:transform .15s,box-shadow .15s}
.case:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--shadow)}
.case:nth-child(4n+2){--c:var(--pop)}
.case:nth-child(4n+3){--c:#ffc933}
.case:nth-child(4n+4){--c:#19c28a}
.case .tools li,.chips li{background:var(--chip);color:var(--ink);border:2px solid var(--ink);font-weight:700}
.case .res{border:2px dashed var(--ink);background:var(--ok-bg)}
.case .more{color:var(--ink);text-decoration-color:var(--pop);text-decoration-thickness:3px;text-underline-offset:4px}
.dot{width:36px;height:36px;border:2px solid var(--ink);background:#ffc933;color:#16123a}
.flow li.done .dot{background:var(--ok-bg);color:var(--ok)}
.flow li::before{left:17px;top:36px;opacity:.4}
@media (min-width:760px){.flow li::before{left:48px;top:17px}}
.job{border-left:4px solid var(--pop)}
.chat{background:var(--surface);border:2px solid var(--ink);border-radius:22px;box-shadow:8px 8px 0 var(--shadow);overflow:hidden;margin-top:36px}
.chat-head{display:flex;gap:10px;align-items:center;padding:12px 16px;background:var(--accent);color:var(--accent-ink);font-weight:700}
.chat-head i{font-style:normal;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#ffc933;border:2px solid var(--ink)}
.chat-head small{display:block;font-weight:400;opacity:.85}
.chat-body{padding:16px;display:flex;flex-direction:column;gap:10px;min-height:270px}
.msg{max-width:86%;padding:10px 14px;border:2px solid var(--ink);border-radius:16px;font-size:.95rem;line-height:1.4;opacity:0;transform:translateY(10px);animation:pop .45s forwards}
.msg.bot{background:var(--chip);color:var(--ink);align-self:flex-start;border-bottom-left-radius:4px}
.msg.me{background:var(--accent);color:var(--accent-ink);align-self:flex-end;border-bottom-right-radius:4px}
.msg:nth-child(1){animation-delay:.5s}.msg:nth-child(2){animation-delay:1.7s}.msg:nth-child(3){animation-delay:2.8s}.msg:nth-child(4){animation-delay:4.3s}
.msg .fake{display:block;margin-top:8px;padding:6px 12px;border:2px solid var(--ink);border-radius:10px;background:var(--surface);color:var(--ink);font-weight:700;text-align:center}
.chat-foot{padding:10px 16px;border-top:2px solid var(--ink);font-size:.85rem;color:var(--muted)}
@keyframes pop{to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.msg{animation:none;opacity:1;transform:none}.btn,.case{transition:none}}
@media (min-width:900px){.hero{display:grid;grid-template-columns:1.15fr .85fr;column-gap:48px;align-items:start}.hero>*{grid-column:1}.hero>.chat{grid-column:2;grid-row:1/6;margin-top:8px}}

/* calmer, more refined pass */
.card,.cta,.flow-card,.case,.theme{border-width:1.5px;box-shadow:0 1px 0 var(--shadow),0 12px 28px -18px var(--shadow)}
.flow-card,.cta{box-shadow:0 1px 0 var(--shadow),0 18px 40px -24px var(--shadow)}
.chat{border-width:1.5px;box-shadow:0 1px 0 var(--shadow),0 24px 48px -28px var(--shadow)}
.btn{border-width:1.5px;box-shadow:none}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 20px -12px var(--shadow)}
.btn:active{transform:none}
.case,.case:nth-child(n){--c:var(--accent)}
.case{border-top-width:4px}
.case:hover{transform:translateY(-3px);box-shadow:0 1px 0 var(--shadow),0 18px 36px -20px var(--shadow)}
.case .res{border:1.5px solid var(--line);background:var(--ok-bg)}
.case .tools li,.chips li{border-width:1.5px;font-weight:600;background:var(--chip)}
h2::before{display:none}
.facts span{border-width:1.5px}
.msg,.msg .fake,.chat-head i,.chat-foot{border-width:1.5px}
.dot{border-width:1.5px}
body{background-image:radial-gradient(var(--dot) 1px,transparent 1px);background-size:28px 28px}
:root{--chip:#e4e1ff;--dot:#d3d6f5}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--chip:#2c2766;--dot:#221f52}}
:root[data-theme="dark"]{--chip:#2c2766;--dot:#221f52}
</style>
</head>
